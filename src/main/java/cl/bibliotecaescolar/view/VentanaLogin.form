<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="cl.bibliotecaescolar.view.VentanaLogin">
  <grid id="27dc6" binding="panelLogin" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties>
      <preferredSize width="300" height="200"/>
    </properties>
    <border type="none"/>
    <children>
      <grid id="b1c92" binding="panelSuperior" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints border-constraint="North"/>
        <properties>
          <background color="-13675815"/>
          <preferredSize width="-1" height="80"/>
        </properties>
        <border type="none"/>
        <children>
          <component id="14a61" class="javax.swing.JLabel" binding="txtTitulo">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font size="16" style="1"/>
              <foreground color="-1"/>
              <text value="Biblioteca Escolar"/>
            </properties>
          </component>
          <grid id="4a064" binding="panelSubtitulo" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="0" left="0" bottom="0" right="0"/>
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="df6b3" class="javax.swing.JLabel" binding="txtSubtitulo">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Ingrese sus datos para iniciar sesión."/>
                </properties>
              </component>
            </children>
          </grid>
        </children>
      </grid>
      <grid id="5cb83" binding="panelIniciarSesion" layout-manager="GridLayoutManager" row-count="3" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints border-constraint="Center"/>
        <properties>
          <preferredSize width="260" height="100"/>
        </properties>
        <border type="none"/>
        <children>
          <grid id="245b0" binding="panelSesion" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="0" left="0" bottom="0" right="0"/>
            <constraints>
              <grid row="2" column="1" row-span="1" col-span="2" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false">
                <preferred-size width="-1" height="50"/>
              </grid>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="b956b" class="javax.swing.JButton" binding="btnIniciarSesion">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Iniciar sesión"/>
                </properties>
              </component>
            </children>
          </grid>
          <component id="1dc17" class="javax.swing.JLabel" binding="txtCorreo">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Correo:"/>
            </properties>
          </component>
          <component id="5e47a" class="javax.swing.JTextField" binding="inputCorreo">
            <constraints>
              <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="0" indent="0" use-parent-layout="false">
                <preferred-size width="150" height="-1"/>
              </grid>
            </constraints>
            <properties/>
          </component>
          <component id="beb75" class="javax.swing.JLabel" binding="txtContrasenia">
            <constraints>
              <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Contraseña:"/>
            </properties>
          </component>
          <hspacer id="4c5e2">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="20" height="-1"/>
              </grid>
            </constraints>
          </hspacer>
          <component id="3ff83" class="javax.swing.JPasswordField" binding="passwordContrasenia">
            <constraints>
              <grid row="1" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="0" indent="0" use-parent-layout="false">
                <preferred-size width="150" height="-1"/>
              </grid>
            </constraints>
            <properties/>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
