<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="cl.bibliotecaescolar.view.VentanaPrincipal">
  <grid id="27dc6" binding="panelPrincipal" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties>
      <preferredSize width="600" height="400"/>
    </properties>
    <border type="none"/>
    <children>
      <grid id="25cfc" binding="panelSuperior" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints border-constraint="North"/>
        <properties>
          <background color="-13675815"/>
          <preferredSize width="167" height="50"/>
        </properties>
        <border type="none"/>
        <children>
          <component id="16ce2" class="javax.swing.JLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font size="16" style="1"/>
              <foreground color="-1"/>
              <text value="Biblioteca Escolar"/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="80f88" binding="panelBotones" layout-manager="GridLayoutManager" row-count="5" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints border-constraint="Center"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="6d251" class="javax.swing.JButton" binding="btnGestionLibros">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false">
                <preferred-size width="200" height="-1"/>
              </grid>
            </constraints>
            <properties>
              <text value="Gestion Libros"/>
            </properties>
          </component>
          <component id="da0b5" class="javax.swing.JButton" binding="btnGestionEstudiantes">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false">
                <preferred-size width="200" height="-1"/>
              </grid>
            </constraints>
            <properties>
              <text value="Gestion Estudiantes"/>
            </properties>
          </component>
          <component id="aa3bb" class="javax.swing.JButton" binding="btnReportes">
            <constraints>
              <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false">
                <preferred-size width="200" height="-1"/>
              </grid>
            </constraints>
            <properties>
              <text value="Reportes y Estadísticas"/>
            </properties>
          </component>
          <component id="a34ef" class="javax.swing.JButton" binding="btnGestionPrestamos">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false">
                <preferred-size width="200" height="-1"/>
              </grid>
            </constraints>
            <properties>
              <text value="Préstamos y Devoluciones"/>
            </properties>
          </component>
          <component id="ec25b" class="javax.swing.JButton" binding="btnCerrarSesion">
            <constraints>
              <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false">
                <preferred-size width="200" height="-1"/>
              </grid>
            </constraints>
            <properties>
              <text value="Cerrar Sesion"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
